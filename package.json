{
  "name": "moliwarden",
  "version": "1.8.0",
  "description": "Bitwarden-compatible server for Vercel (PostgreSQL + S3)",
  "license": "LGPL-3.0",
  "type": "module",
  "scripts": {
    "dev:demo": "vite --config webapp/vite.config.ts --mode demo --host 127.0.0.1 --port 5174",
    "build": "vite build --config webapp/vite.config.ts",
    "domains:sync": "node scripts/sync-global-domains.mjs",
    "i18n": "node scripts/i18n-validate.cjs",
    "i18n:validate": "node scripts/i18n-validate.cjs",
    "test:config-compatibility": "tsx --test scripts/config-compatibility.test.ts",
    "test:web-crypto": "tsx --test scripts/web-crypto-availability.test.ts",
    "test:webauthn-mobile": "node --test scripts/webauthn-mobile-connector.test.mjs",
    "test:webauthn-connector": "node --test scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "test:webauthn-connectors": "node --test scripts/webauthn-mobile-connector.test.mjs scripts/webauthn-connector.test.mjs && tsx --test scripts/webauthn-connector-headers.test.ts",
    "build:vercel": "tsx scripts/build-vercel.ts",
    "dev:server": "tsx scripts/dev-server.ts",
    "typecheck": "tsc --noEmit -p .",
    "test:e2e": "tsx --test --test-concurrency=1 tests/*.e2e.test.ts",
    "test:official-cli": "tsx --test tests/official-cli.test.ts",
    "check:css-colors": "node scripts/check-css-colors.mjs",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate-legacy": "tsx scripts/migrate-legacy.ts",
    "backup:convert-v1": "tsx scripts/convert-backup-v1.ts",
    "test:smoke": "npm run build:vercel && tsx --test tests/vercel-output.smoke.test.ts",
    "typecheck:web": "tsc --noEmit -p webapp",
    "test:ui": "bash scripts/test-ui.sh",
    "test:unit": "tsx --test tests/unit/*.test.ts && npm run test:config-compatibility && npm run test:web-crypto && npm run test:webauthn-connectors",
    "test": "npm run typecheck && npm run typecheck:web && npm run i18n:validate && npm run check:css-colors && npm run test:unit && npm run test:e2e && npm run test:official-cli && npm run test:ui && npm run test:smoke",
    "test:services": "docker compose -f tests/services/docker-compose.yml up -d --wait",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "keywords": [
    "bitwarden",
    "vaultwarden",
    "vercel",
    "postgres",
    "password-manager"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "undici": "8.9.0",
    "@babel/core": ">=7.29.6",
    "esbuild": "$esbuild",
    "ws": "8.21.0",
    "sharp": "0.35.4",
    "browserslist": "4.28.7",
    "baseline-browser-mapping": "2.11.0",
    "postcss-selector-parser": "6.1.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.3"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@noble/hashes": "^2.2.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@vercel/functions": "^3.9.9",
    "@zip.js/zip.js": "^2.8.26",
    "aws4fetch": "^1.0.20",
    "fflate": "^0.8.3",
    "hono": "^4.13.11",
    "jsqr": "1.4.0",
    "kysely": "^0.29.6",
    "lucide-preact": "^1.22.0",
    "pg": "^8.23.0",
    "preact": "^10.29.3",
    "qrcode-generator": "^2.0.4",
    "wouter": "^3.10.0",
    "zod": "^4.6.5"
  }
}
